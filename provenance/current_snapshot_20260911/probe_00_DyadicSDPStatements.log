theorem MatrixSpencer.DyadicOwnerSDP.exists_maximizer.{u_1, u_2} : ∀ {n : Type u_1} {ι : Type u_2} [inst : Fintype n]
  [inst_1 : LinearOrder n] [inst_2 : Fintype ι] [inst_3 : DecidableEq ι] (m : ℕ) (a : n) (H : Matrix n n ℂ)
  (A : ι → Matrix n n ℂ) (hA : ∀ (i : ι), (A i).IsHermitian) (C : Matrix ι ι ℝ) (hC : C.PosSemidef),
  1 ≤ m →
    ∀ {θ : ℝ},
      0 < θ →
        ∃ x ∈ MatrixSpencer.DyadicOwnerSDP.feasible m a A hA C hC,
          MatrixSpencer.DyadicOwnerSDP.objective m a H θ x = MatrixSpencer.dyadicOwnerPotential H A C m θ ∧
            ∀ y ∈ MatrixSpencer.DyadicOwnerSDP.feasible m a A hA C hC,
              MatrixSpencer.DyadicOwnerSDP.objective m a H θ y ≤ MatrixSpencer.DyadicOwnerSDP.objective m a H θ x :=
fun {n} {ι} [Fintype n] [LinearOrder n] [Fintype ι] [DecidableEq ι] m a H A hA C hC hm {θ} hθ =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          ∃ x ∈ _a,
            MatrixSpencer.DyadicOwnerSDP.objective m a H θ x = MatrixSpencer.dyadicOwnerPotential H A C m θ ∧
              ∀ y ∈ _a,
                MatrixSpencer.DyadicOwnerSDP.objective m a H θ y ≤ MatrixSpencer.DyadicOwnerSDP.objective m a H θ x)
        (MatrixSpencer.DyadicOwnerSDP.feasible_eq m a A hA C hC)))
    (MatrixSpencer.DyadicSDPAffineObjective.owner_exists_maximizer m a H A hA hC (MatrixSpencer.DyadicOwnerSDP.center a)
      (MatrixSpencer.DyadicOwnerSDP.center_trace a) hm hθ)
theorem MatrixSpencer.DyadicOwnerSDP.rectangular_exists_maximizer : ∀ {N D : ℕ},
  1 ≤ N →
    N ≤ D →
      ∀ (a : Fin (2 * D)) (H : Matrix (Fin (2 * D)) (Fin (2 * D)) ℂ) (A : Fin N → Matrix (Fin (2 * D)) (Fin (2 * D)) ℂ)
        (hA : ∀ (i : Fin N), (A i).IsHermitian) (C : Matrix (Fin N) (Fin N) ℝ) (hC : C.PosSemidef),
        have m := MatrixSpencer.RectangularTunedParameters.depth N D;
        have θ := MatrixSpencer.RectangularTunedParameters.weight N D;
        ∃ x ∈ MatrixSpencer.DyadicOwnerSDP.feasible m a A hA C hC,
          MatrixSpencer.DyadicOwnerSDP.objective m a H θ x = MatrixSpencer.dyadicOwnerPotential H A C m θ ∧
            ∀ y ∈ MatrixSpencer.DyadicOwnerSDP.feasible m a A hA C hC,
              MatrixSpencer.DyadicOwnerSDP.objective m a H θ y ≤ MatrixSpencer.DyadicOwnerSDP.objective m a H θ x :=
fun {N D} hN hND a H A hA C hC =>
  MatrixSpencer.DyadicOwnerSDP.exists_maximizer (MatrixSpencer.RectangularTunedParameters.depth N D) a H A hA C hC
    (MatrixSpencer.RectangularTunedParameters.depth_positive N D)
    (MatrixSpencer.RectangularTunedParameters.weight_positive hN hND)
theorem MatrixSpencer.DyadicOwnerSDP.rectangular_size_bounds : ∀ {N D : ℕ},
  1 ≤ N →
    1 ≤ D →
      ∀ (a : Fin (2 * D)),
        have m := MatrixSpencer.RectangularTunedParameters.depth N D;
        MatrixSpencer.DyadicSDPCoordinates.dimension m a ≤ 4 * (2 * D + 5) * D ^ 2 ∧
          Fintype.card (MatrixSpencer.DyadicSDPAffineData.Constraint m) ≤ 4 * D + 5 ∧
            MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) = 8 * D ∧
              Fintype.card (MatrixSpencer.DyadicSDPAffineData.Constraint m) *
                    (MatrixSpencer.DyadicSDPCoordinates.dimension m a + 1) *
                  MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 ≤
                256 * (4 * D + 5) * (2 * D + 5) * D ^ 4 :=
fun {N D} hN hD a =>
  id
    (have h := MatrixSpencer.DyadicOwnerSDP.actual_size_bounds (MatrixSpencer.RectangularTunedParameters.depth N D) a;
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            _a ≤ 4 * (2 * D + 5) * D ^ 2 ∧
              Fintype.card
                    (MatrixSpencer.DyadicSDPAffineData.Constraint
                      (MatrixSpencer.RectangularTunedParameters.depth N D)) ≤
                  4 * D + 5 ∧
                MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) = 8 * D ∧
                  Fintype.card
                          (MatrixSpencer.DyadicSDPAffineData.Constraint
                            (MatrixSpencer.RectangularTunedParameters.depth N D)) *
                        (_a + 1) *
                      MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 ≤
                    256 * (4 * D + 5) * (2 * D + 5) * D ^ 4)
          (Eq.mp
              (congr
                (congrArg
                  (fun x =>
                    And
                      (MatrixSpencer.DyadicSDPCoordinates.dimension (MatrixSpencer.RectangularTunedParameters.depth N D)
                          a =
                        MatrixSpencer.DyadicSDPProgramSize.variableCount
                          (MatrixSpencer.RectangularTunedParameters.depth N D) x))
                  (Fintype.card_fin (2 * D)))
                (congrArg
                  (And
                    (Fintype.card
                        (MatrixSpencer.DyadicSDPAffineData.Constraint
                          (MatrixSpencer.RectangularTunedParameters.depth N D)) =
                      MatrixSpencer.DyadicSDPProgramSize.constraintCount
                        (MatrixSpencer.RectangularTunedParameters.depth N D)))
                  (congr
                    (congrArg
                      (fun x =>
                        And
                          (MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) =
                            MatrixSpencer.DyadicSDPProgramSize.blockOrder x))
                      (Fintype.card_fin (2 * D)))
                    (congrArg
                      (fun x =>
                        Fintype.card
                                (MatrixSpencer.DyadicSDPAffineData.Constraint
                                  (MatrixSpencer.RectangularTunedParameters.depth N D)) *
                              (MatrixSpencer.DyadicSDPCoordinates.dimension
                                  (MatrixSpencer.RectangularTunedParameters.depth N D) a +
                                1) *
                            MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 =
                          16 * (2 * MatrixSpencer.RectangularTunedParameters.depth N D + 1) *
                              (MatrixSpencer.RectangularTunedParameters.depth N D + 3) *
                            x ^ 4)
                      (Fintype.card_fin (2 * D))))))
              h).left))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              MatrixSpencer.DyadicSDPProgramSize.variableCount (MatrixSpencer.RectangularTunedParameters.depth N D)
                    (2 * D) ≤
                  4 * (2 * D + 5) * D ^ 2 ∧
                _a ≤ 4 * D + 5 ∧
                  MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) = 8 * D ∧
                    _a *
                          (MatrixSpencer.DyadicSDPProgramSize.variableCount
                              (MatrixSpencer.RectangularTunedParameters.depth N D) (2 * D) +
                            1) *
                        MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 ≤
                      256 * (4 * D + 5) * (2 * D + 5) * D ^ 4)
            (Eq.mp
                  (congr
                    (congrArg
                      (fun x =>
                        And
                          (MatrixSpencer.DyadicSDPCoordinates.dimension
                              (MatrixSpencer.RectangularTunedParameters.depth N D) a =
                            MatrixSpencer.DyadicSDPProgramSize.variableCount
                              (MatrixSpencer.RectangularTunedParameters.depth N D) x))
                      (Fintype.card_fin (2 * D)))
                    (congrArg
                      (And
                        (Fintype.card
                            (MatrixSpencer.DyadicSDPAffineData.Constraint
                              (MatrixSpencer.RectangularTunedParameters.depth N D)) =
                          MatrixSpencer.DyadicSDPProgramSize.constraintCount
                            (MatrixSpencer.RectangularTunedParameters.depth N D)))
                      (congr
                        (congrArg
                          (fun x =>
                            And
                              (MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) =
                                MatrixSpencer.DyadicSDPProgramSize.blockOrder x))
                          (Fintype.card_fin (2 * D)))
                        (congrArg
                          (fun x =>
                            Fintype.card
                                    (MatrixSpencer.DyadicSDPAffineData.Constraint
                                      (MatrixSpencer.RectangularTunedParameters.depth N D)) *
                                  (MatrixSpencer.DyadicSDPCoordinates.dimension
                                      (MatrixSpencer.RectangularTunedParameters.depth N D) a +
                                    1) *
                                MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 =
                              16 * (2 * MatrixSpencer.RectangularTunedParameters.depth N D + 1) *
                                  (MatrixSpencer.RectangularTunedParameters.depth N D + 3) *
                                x ^ 4)
                          (Fintype.card_fin (2 * D))))))
                  h).right.left))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                MatrixSpencer.DyadicSDPProgramSize.variableCount (MatrixSpencer.RectangularTunedParameters.depth N D)
                      (2 * D) ≤
                    4 * (2 * D + 5) * D ^ 2 ∧
                  MatrixSpencer.DyadicSDPProgramSize.constraintCount
                        (MatrixSpencer.RectangularTunedParameters.depth N D) ≤
                      4 * D + 5 ∧
                    _a = 8 * D ∧
                      MatrixSpencer.DyadicSDPProgramSize.constraintCount
                              (MatrixSpencer.RectangularTunedParameters.depth N D) *
                            (MatrixSpencer.DyadicSDPProgramSize.variableCount
                                (MatrixSpencer.RectangularTunedParameters.depth N D) (2 * D) +
                              1) *
                          _a ^ 2 ≤
                        256 * (4 * D + 5) * (2 * D + 5) * D ^ 4)
              (Eq.mp
                      (congr
                        (congrArg
                          (fun x =>
                            And
                              (MatrixSpencer.DyadicSDPCoordinates.dimension
                                  (MatrixSpencer.RectangularTunedParameters.depth N D) a =
                                MatrixSpencer.DyadicSDPProgramSize.variableCount
                                  (MatrixSpencer.RectangularTunedParameters.depth N D) x))
                          (Fintype.card_fin (2 * D)))
                        (congrArg
                          (And
                            (Fintype.card
                                (MatrixSpencer.DyadicSDPAffineData.Constraint
                                  (MatrixSpencer.RectangularTunedParameters.depth N D)) =
                              MatrixSpencer.DyadicSDPProgramSize.constraintCount
                                (MatrixSpencer.RectangularTunedParameters.depth N D)))
                          (congr
                            (congrArg
                              (fun x =>
                                And
                                  (MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) =
                                    MatrixSpencer.DyadicSDPProgramSize.blockOrder x))
                              (Fintype.card_fin (2 * D)))
                            (congrArg
                              (fun x =>
                                Fintype.card
                                        (MatrixSpencer.DyadicSDPAffineData.Constraint
                                          (MatrixSpencer.RectangularTunedParameters.depth N D)) *
                                      (MatrixSpencer.DyadicSDPCoordinates.dimension
                                          (MatrixSpencer.RectangularTunedParameters.depth N D) a +
                                        1) *
                                    MatrixSpencer.DyadicSDPAffineData.matrixSize (Fin (2 * D)) ^ 2 =
                                  16 * (2 * MatrixSpencer.RectangularTunedParameters.depth N D + 1) *
                                      (MatrixSpencer.RectangularTunedParameters.depth N D + 3) *
                                    x ^ 4)
                              (Fintype.card_fin (2 * D))))))
                      h).right.right.left))
          (MatrixSpencer.DyadicSDPProgramSize.rectangular_sizes hN hD))))
